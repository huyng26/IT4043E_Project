FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml models.py ./
COPY collectors ./collectors
COPY database ./database
COPY streaming ./streaming
RUN pip install '.[streaming]' && useradd --create-home --uid 10002 streaming && mkdir /checkpoints && chown streaming:streaming /checkpoints
USER streaming
# Resolve the matching Kafka connector during the build, not on every restart.
RUN python -c "from pyspark.sql import SparkSession; from streaming.spark import KAFKA_PACKAGE; s=SparkSession.builder.master('local[1]').config('spark.jars.packages', KAFKA_PACKAGE).getOrCreate(); s.stop()"
ENV STREAMING_CHECKPOINT_LOCATION=/checkpoints/mongo
CMD ["python", "-m", "streaming.spark"]
